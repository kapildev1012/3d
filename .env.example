# .env.example: copy to .env (git-ignored) and fill in ONE block. Keys are never printed or committed.

# Gemini (OpenAI-compatible endpoint)
# VITE_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# VITE_LLM_API_KEY=your-gemini-key
# VITE_LLM_MODEL=gemini-2.5-flash

# Groq
# VITE_LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# VITE_LLM_API_KEY=your-groq-key
# VITE_LLM_MODEL=llama-3.3-70b-versatile

# Local Ollama (no key needed)
# VITE_LLM_API_URL=http://localhost:11434/v1/chat/completions
# VITE_LLM_API_KEY=ollama
# VITE_LLM_MODEL=qwen2.5-coder:7b

# Anthropic / OpenAI native (used when no VITE_LLM_API_URL is set)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
