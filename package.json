{
  "name": "ntrtsim-3d-tensegrity-live",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build": "node tools/build.mjs",
    "preview": "ROOT=dist node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:research": "node --test tests/lagrangianDae.test.mjs tests/researchMode.test.mjs tests/benchmarkStore.test.mjs",
    "verify": "npm run build && npm test",
    "tsgfem:validate": "node tools/tsgfem_validate.mjs",
    "seed": "node tools/make_seed_benchmarks.mjs --duration 20",
    "experiments": "node tools/run_experiments.mjs --workers 2 --duration 20",
    "paper:data": "node tools/summarize_experiments.mjs && node tools/make_numbers.mjs && python3 tools/make_figures.py",
    "paper:pdf": "cd paper && latexmk -pdf -interaction=nonstopmode main.tex",
    "hybrid": "node tools/run_hybrid_training.mjs",
    "hybrid:rl": "node tools/run_hybrid_training.mjs --no-tuner",
    "hybrid:quick": "node tools/run_hybrid_training.mjs --outer-rounds 1 --candidates 4 --inner-episodes 4 --episode-duration 2 --min-inner-steps 0 --eval-duration 4 --out results/hybrid_quick",
    "paper:ext": "node tools/measure_sag.mjs && node tools/make_extension_tables.mjs && node tools/teaser_frames.mjs && python3 tools/make_teaser.py",
    "final:octave": "cd final_codes && octave --no-gui --quiet --eval MainFile",
    "final:validate": "node tools/final_codes_validate.mjs",
    "final:identify": "node tools/run_param_identification.mjs"
  }
}
